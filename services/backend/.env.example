# ============================================================================
# SECURITY NOTICE: NEVER commit real secrets to version control!
# Create a .env file with production values and add it to .gitignore
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
DATABASE_FILE=./data/softupakaran.db

# ============================================================================
# JWT & Authentication Secrets (CRITICAL - Change in Production!)
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production_12345
ACCESS_TOKEN_COOKIE_NAME=spk_access
REFRESH_TOKEN_COOKIE_NAME=spk_refresh

# Cookie Security Settings
# For production with HTTPS:
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none (for cross-origin requests)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ============================================================================
# Authentication & Rate Limiting
# Helps prevent brute force attacks and DoS
# ============================================================================
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_LOGIN_MAX=20
AUTH_RATE_LIMIT_REGISTER_MAX=8
AUTH_RATE_LIMIT_GOOGLE_MAX=20
AUTH_RATE_LIMIT_REFRESH_MAX=40

# Admin Operations Rate Limiting (30 requests per minute per IP)
ADMIN_OPERATION_RATE_LIMIT_WINDOW=1m
ADMIN_OPERATION_RATE_LIMIT_MAX=30

# Account Lockout Protection
# Locks accounts after failed login attempts to prevent brute force
AUTH_LOCKOUT_THRESHOLD=6
AUTH_LOCKOUT_WINDOW=15m
AUTH_LOCKOUT_DURATION=30m

# ============================================================================
# Admin User (Created automatically on startup)
# ============================================================================
ADMIN_EMAIL=admin@softupakaran.local
ADMIN_PASSWORD=admin12345

# ============================================================================
# CORS & Frontend Configuration
# ============================================================================
# Comma-separated list of allowed origins (in addition to defaults)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8085
FRONTEND_URL=http://localhost:8085
GOOGLE_AUTHORIZED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8085,http://127.0.0.1:8085

# ============================================================================
# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com
# ============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_IDS=

# ============================================================================
# Backup Configuration (CRITICAL - Use strong token in production!)
# ============================================================================
BACKUP_TOKEN=your_backup_token_change_in_production_12345

# Google Drive Backup (optional service account)
GDRIVE_FOLDER_ID=
GDRIVE_SA_JSON=

# ============================================================================
# OpenAI Configuration (Optional - for AI chatbot)
# ============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SYSTEM_PROMPT=You are SoftUpakaran's friendly assistant. Answer customer questions about digital delivery, subscriptions, payments, refunds, admin support, and WhatsApp proof. Keep responses short, actionable, and reference Nepal where it helps.
